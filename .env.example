# Copy to .env for local use with `netlify dev`, or set these as
# environment variables in your Netlify site settings (Site configuration
# -> Environment variables) for production.

# Required to enable real AI conversations in the live demo widget.
# Without this set, the widget automatically falls back to a scripted
# demo — the site still works, it just isn't using live AI.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5. Use a smaller/cheaper model
# (e.g. claude-haiku-4-5-20251001) if you want to cut cost on a
# high-traffic public widget.
CHAT_MODEL=

# Required to enable real missed-call text-back and SMS conversations
# (netlify/functions/twilio-voice.mts, twilio-voice-status.mts, sms.mts).
# From console.twilio.com — Account SID and Auth Token are on the
# dashboard, and are shared across every business's Twilio number under
# that one account (no per-business env var needed — each business's
# own number, added at /admin.html, is used automatically as the "from"
# for its texts).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Required to use /admin.html, the page for adding/removing which real
# businesses this deployment answers for (keyed by phone number). Make
# this a long random string — anyone with it can add or delete
# businesses. Leaving it unset disables the admin page/API entirely.
ADMIN_KEY=

# Optional. Your Stripe Payment Link URL (see README's "Selling it"
# section) — the pricing button links straight to checkout once this
# is set. Note the VITE_ prefix: this one is exposed to the browser (it
# needs to be, it's a public checkout link), unlike everything else in
# this file. Changing it or the price later is just updating this and
# redeploying — no code edit needed.
VITE_PAYMENT_LINK_URL=
